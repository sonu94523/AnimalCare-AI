# Backend configuration (Flask)
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set a strong random token on the server to enable DELETE /api/history routes.
# Do NOT expose this token via VITE_* env vars; enter it at runtime in the History prompt.
ADMIN_TOKEN=

# Optional overrides (defaults to backend/database/animalcare.db and ml/saved_models)
# DATABASE_URL=sqlite:///backend/database/animalcare.db
# MODELS_DIR=ml/saved_models
# DATASET_DIR=ml/dataset

# Frontend configuration (Vite)
VITE_API_URL=http://localhost:5000
